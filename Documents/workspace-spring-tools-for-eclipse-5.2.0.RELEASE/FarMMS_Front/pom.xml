<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        Spring Boot 프로젝트의 기본 설정을 제공하는 부모 프로젝트입니다.
        Java 버전과 주요 라이브러리 버전을 Spring Boot가 호환되게 관리합니다.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!-- 프로젝트 식별 정보 -->
    <groupId>com.farmms</groupId>
	<artifactId>farmms-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>FarMms</name>
	<description>AI 기반 농자재 홍보 및 MMS 발송 서비스</description>

    <properties>
        <!-- Spring Boot 3.5.x는 Java 17 이상이 필요합니다. -->
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- REST API와 내장 Tomcat 서버를 사용하기 위한 의존성 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- JPA를 사용하여 Java 객체와 DB 테이블을 연결하기 위한 의존성 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- 요청 데이터의 필수값, 길이, 형식 등을 검사하기 위한 의존성 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 실제 배포용 MySQL 데이터베이스 드라이버 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            개발자가 별도 DB 설치 없이 바로 테스트할 수 있도록 사용하는 메모리 DB입니다.
            기본 local 프로필에서만 사용합니다.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Getter, 생성자 등의 반복 코드를 줄여주는 라이브러리 -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 단위 테스트에 사용하는 의존성 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        
        <!-- 로그인 인증과 비밀번호 암호화를 위한 Spring Security -->
		<dependency>
		    <groupId>org.springframework.boot</groupId>
		    <artifactId>spring-boot-starter-security</artifactId>
		</dependency>
        
        <!-- JWT 생성 및 검증 API -->
		<dependency>
		    <groupId>io.jsonwebtoken</groupId>
		    <artifactId>jjwt-api</artifactId>
		    <version>0.13.0</version>
		</dependency>
		
		<!-- JWT 실제 구현체 -->
		<dependency>
		    <groupId>io.jsonwebtoken</groupId>
		    <artifactId>jjwt-impl</artifactId>
		    <version>0.13.0</version>
		    <scope>runtime</scope>
		</dependency>
		
		<!-- JWT 내부 JSON 처리 -->
		<dependency>
		    <groupId>io.jsonwebtoken</groupId>
		    <artifactId>jjwt-jackson</artifactId>
		    <version>0.13.0</version>
		    <scope>runtime</scope>
		</dependency>
        
        
    </dependencies>

    <build>
        <plugins>
            <!-- Spring Boot 애플리케이션을 실행 가능한 JAR 파일로 만드는 플러그인 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
